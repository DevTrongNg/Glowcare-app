{
  "info": {
    "_postman_id": "product-model-api",
    "name": "Product Model API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "Get All Products (Paginate + Filter)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/products?page=1&limit=10&keyword=nike&category=shoes&sort=-price",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "keyword", "value": "nike" },
                { "key": "category", "value": "shoes" },
                { "key": "sort", "value": "-price" }
              ]
            }
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/products/PRODUCT_ID",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "products", "PRODUCT_ID"]
            }
          }
        },
        {
          "name": "Get Product by Slug",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/products/slug/nike-air-zoom",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "products", "slug", "nike-air-zoom"]
            }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nike Air Zoom\",\n  \"slug\": \"nike-air-zoom\",\n  \"category\": [\"shoes\", \"men\"],\n  \"price\": 120,\n  \"image\": \"https://example.com/image.jpg\",\n  \"gallery\": [\"https://example.com/image1.jpg\", \"https://example.com/image2.jpg\"],\n  \"description\": \"Comfortable running shoes\",\n  \"discount\": 10,\n  \"countInStock\": 50,\n  \"featured\": true,\n  \"tags\": [\"nike\", \"running\", \"air\"],\n  \"attributes\": [\"660ff24ad0a29f2eb1a23abc\"]\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/products",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nike Air Max 2025\",\n  \"price\": 150,\n  \"countInStock\": 20,\n  \"featured\": false\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/products/PRODUCT_ID",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "products", "PRODUCT_ID"]
            }
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "http://localhost:8080/api/products/PRODUCT_ID",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "products", "PRODUCT_ID"]
            }
          }
        }
      ]
    }
  ]
}
